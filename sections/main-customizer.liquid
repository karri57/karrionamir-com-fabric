{%- comment -%}
  Interactive design studio: place brand designs (uploaded as section
  blocks) on a tee or hoodie, front and back, recolor the garment, and
  add the configured custom product to cart with the design stored as
  line item properties.
{%- endcomment -%}

{%- liquid
  assign tee_variant = section.settings.tee_product.selected_or_first_available_variant
  assign hoodie_variant = section.settings.hoodie_product.selected_or_first_available_variant
-%}

<ka-customizer class="page-width section kc">
  <script type="application/json" data-kc-config>
    {
      "designs": [
        {%- for block in section.blocks -%}
          {%- if block.type == 'design' and block.settings.image != blank -%}
            {
              "label": {{ block.settings.label | default: 'Design' | json }},
              "src": {{ block.settings.image | image_url: width: 500 | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "variants": {
        "tee": {{ tee_variant.id | json }},
        "hoodie": {{ hoodie_variant.id | json }}
      },
      "prices": {
        "tee": {{ tee_variant.price | json }},
        "hoodie": {{ hoodie_variant.price | json }}
      }
    }
  </script>

  <div class="kc__header">
    <h1 class="kc__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="kc__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  <div class="kc__layout">
    <div class="kc__stage-column">
      <div class="kc__toolbar">
        <div class="kc__toggle" role="tablist" aria-label="Garment">
          <button type="button" data-kc-garment="tee" aria-current="true">Tee</button>
          <button type="button" data-kc-garment="hoodie" aria-current="false">Hoodie</button>
        </div>
        <div class="kc__toggle" role="tablist" aria-label="Side">
          <button type="button" data-kc-view="front" aria-current="true">Front</button>
          <button type="button" data-kc-view="back" aria-current="false">Back</button>
        </div>
      </div>

      <div class="kc__stage" data-kc-stage>
        <div class="kc__garment-wrap" data-kc-tilt>
          <svg viewBox="0 0 400 480" class="kc__garment" data-kc-garment-svg aria-hidden="true">
            <defs>
              <linearGradient id="kc-shade" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#000" stop-opacity="0.12"/>
                <stop offset="0.2" stop-color="#000" stop-opacity="0"/>
                <stop offset="0.8" stop-color="#000" stop-opacity="0"/>
                <stop offset="1" stop-color="#000" stop-opacity="0.12"/>
              </linearGradient>
            </defs>

            <g data-kc-shape="tee-front">
              <path class="kc-fill" d="M118 74 L62 106 L20 224 L92 254 L108 210 L108 434 Q200 456 292 434 L292 210 L308 254 L380 224 L338 106 L282 74 Q252 48 200 50 Q148 48 118 74 Z"/>
              <path d="M118 74 L62 106 L20 224 L92 254 L108 210 L108 434 Q200 456 292 434 L292 210 L308 254 L380 224 L338 106 L282 74 Q252 48 200 50 Q148 48 118 74 Z" fill="url(#kc-shade)"/>
              <path d="M154 66 Q200 94 246 66" fill="none" stroke="rgb(0 0 0 / 22%)" stroke-width="7" stroke-linecap="round"/>
              <path d="M108 210 L108 434 M292 210 L292 434" fill="none" stroke="rgb(0 0 0 / 8%)" stroke-width="2"/>
            </g>

            <g data-kc-shape="tee-back" hidden>
              <path class="kc-fill" d="M118 74 L62 106 L20 224 L92 254 L108 210 L108 434 Q200 456 292 434 L292 210 L308 254 L380 224 L338 106 L282 74 Q252 48 200 50 Q148 48 118 74 Z"/>
              <path d="M118 74 L62 106 L20 224 L92 254 L108 210 L108 434 Q200 456 292 434 L292 210 L308 254 L380 224 L338 106 L282 74 Q252 48 200 50 Q148 48 118 74 Z" fill="url(#kc-shade)"/>
              <path d="M162 60 Q200 74 238 60" fill="none" stroke="rgb(0 0 0 / 22%)" stroke-width="7" stroke-linecap="round"/>
            </g>

            <g data-kc-shape="hoodie-front" hidden>
              <path class="kc-fill" d="M112 96 L54 130 L16 250 L90 280 L104 238 L104 440 Q200 464 296 440 L296 238 L310 280 L384 250 L346 130 L288 96 Q250 66 200 68 Q150 66 112 96 Z"/>
              <path d="M112 96 L54 130 L16 250 L90 280 L104 238 L104 440 Q200 464 296 440 L296 238 L310 280 L384 250 L346 130 L288 96 Q250 66 200 68 Q150 66 112 96 Z" fill="url(#kc-shade)"/>
              <path class="kc-fill" d="M140 92 Q142 44 200 42 Q258 44 260 92 Q262 116 200 122 Q138 116 140 92 Z" stroke="rgb(0 0 0 / 20%)" stroke-width="3"/>
              <path d="M182 116 L178 168 M218 116 L222 168" fill="none" stroke="rgb(0 0 0 / 30%)" stroke-width="4" stroke-linecap="round"/>
              <path class="kc-fill" d="M138 330 L262 330 L246 408 L154 408 Z" stroke="rgb(0 0 0 / 18%)" stroke-width="3"/>
            </g>

            <g data-kc-shape="hoodie-back" hidden>
              <path class="kc-fill" d="M112 96 L54 130 L16 250 L90 280 L104 238 L104 440 Q200 464 296 440 L296 238 L310 280 L384 250 L346 130 L288 96 Q250 66 200 68 Q150 66 112 96 Z"/>
              <path d="M112 96 L54 130 L16 250 L90 280 L104 238 L104 440 Q200 464 296 440 L296 238 L310 280 L384 250 L346 130 L288 96 Q250 66 200 68 Q150 66 112 96 Z" fill="url(#kc-shade)"/>
              <path class="kc-fill" d="M148 96 Q150 60 200 58 Q250 60 252 96 Q254 110 200 114 Q146 110 148 96 Z" stroke="rgb(0 0 0 / 20%)" stroke-width="3"/>
            </g>
          </svg>
          <div class="kc__placements" data-kc-placements></div>
        </div>
      </div>

      <div class="kc__selection-tools" data-kc-tools hidden>
        <button type="button" data-kc-tool="smaller" aria-label="Smaller">&minus;</button>
        <button type="button" data-kc-tool="bigger" aria-label="Bigger">+</button>
        <button type="button" data-kc-tool="rotate-left" aria-label="Rotate left">&#8634;</button>
        <button type="button" data-kc-tool="rotate-right" aria-label="Rotate right">&#8635;</button>
        <button type="button" data-kc-tool="delete" aria-label="Remove design">{% render 'icon', name: 'delete' %}</button>
      </div>
    </div>

    <div class="kc__panel">
      <div class="kc__panel-group">
        <span class="kc__panel-label">Color</span>
        <div class="kc__colors" data-kc-colors>
          <button type="button" data-kc-color="#ffffff" style="--c: #ffffff;" aria-current="true" aria-label="White"></button>
          <button type="button" data-kc-color="#111111" style="--c: #111111;" aria-current="false" aria-label="Black"></button>
          <button type="button" data-kc-color="#b7b7b7" style="--c: #b7b7b7;" aria-current="false" aria-label="Heather grey"></button>
          <button type="button" data-kc-color="#c2b280" style="--c: #c2b280;" aria-current="false" aria-label="Sand"></button>
          <button type="button" data-kc-color="#31425f" style="--c: #31425f;" aria-current="false" aria-label="Navy"></button>
          <button type="button" data-kc-color="#6d1a24" style="--c: #6d1a24;" aria-current="false" aria-label="Wine"></button>
        </div>
      </div>

      <div class="kc__panel-group">
        <span class="kc__panel-label">Designs &mdash; tap to place</span>
        <div class="kc__designs" data-kc-designs>
          <p class="kc__empty" data-kc-designs-empty>No designs uploaded yet. Add design images to this section in the theme editor.</p>
        </div>
      </div>

      <div class="kc__actions">
        <button type="button" class="button button--full" data-kc-add hidden>
          Add to cart <span aria-hidden="true">&bull;</span> <span data-kc-price></span>
        </button>
        <button type="button" class="button button--secondary button--full" data-kc-download>
          Download preview
        </button>
        <p class="kc__note" data-kc-note hidden>
          To sell custom pieces, pick the tee and hoodie products in this section's theme-editor settings.
        </p>
      </div>
    </div>
  </div>
</ka-customizer>

<script src="{{ 'customizer.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Design studio",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design studio" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Pick a garment, place our designs, make it yours." },
    { "type": "product", "id": "tee_product", "label": "Custom tee product", "info": "The product added to cart for custom tees. The design is attached as line item properties on the order." },
    { "type": "product", "id": "hoodie_product", "label": "Custom hoodie product" }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best." }
      ]
    }
  ]
}
{% endschema %}
