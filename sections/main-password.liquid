<div style="max-width: 26rem;">
  {%- if settings.logo != blank -%}
    <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="160" height="{{ 160 | divided_by: settings.logo.aspect_ratio | default: 60 }}" style="margin-inline: auto; margin-bottom: 1.5rem;">
  {%- else -%}
    <h1 style="margin-bottom: 1.5rem;">{{ shop.name }}</h1>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="form-error">{{ form.errors.messages['form'] }}</p>
    {%- endif -%}
    <div class="field" style="margin-bottom: 1rem;">
      <label class="visually-hidden" for="Password">Password</label>
      <input type="password" class="field__input" id="Password" name="password" placeholder="Password">
    </div>
    <button type="submit" class="button button--full">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
