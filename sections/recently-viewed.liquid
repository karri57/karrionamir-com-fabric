{%- comment -%}
  Client-rendered "Recently viewed" carousel, sourced from localStorage
  (see window.themeRecentlyViewed in theme.js). Empty until the shopper
  has actually viewed other products, so it stays hidden until then.
{%- endcomment -%}

<recently-viewed-products
  class="section page-width"
  data-exclude-id="{{ product.id }}"
  hidden
>
  <div class="section__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <a href="{{ routes.all_products_collection_url }}" class="section__link">
      {{ 'collections.general.view_more' | t }}
    </a>
  </div>

  <div class="carousel-row" data-recently-viewed-items></div>
</recently-viewed-products>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" }
  ]
}
{% endschema %}
