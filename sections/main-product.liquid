{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign color_option_index = -1
  for option in product.options_with_values
    assign option_name_down = option.name | downcase
    if option_name_down contains 'color' or option_name_down contains 'colour'
      assign color_option_index = forloop.index0
    endif
  endfor

  if section.settings.show_newsletter_incentive
    assign discount_multiplier = 100 | minus: settings.newsletter_discount_percent | divided_by: 100.0
    assign discounted_price = current_variant.price | times: discount_multiplier | round
    assign discounted_price_formatted = discounted_price | money
  endif
-%}

<div class="product-page">
  <product-gallery class="product__gallery">
    <div class="product__gallery-main" data-gallery-main>
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media.preview_image | image_url: width: 800 }}"
          alt="{{ product.featured_media.alt | escape }}"
          width="800"
          height="{{ 800 | divided_by: product.featured_media.preview_image.aspect_ratio | default: 1000 }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}

      <button type="button" class="product__gallery-zoom" data-gallery-zoom aria-label="{{ 'products.product.zoom_image' | t }}">
        {% render 'icon', name: 'search' %}
      </button>

      {%- if product.media.size > 1 -%}
        <button type="button" class="product__gallery-next" data-gallery-next aria-label="{{ 'products.product.next_image' | t }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="product__gallery-dots" role="tablist">
        {%- for media in product.media -%}
          <button
            type="button"
            class="product__gallery-dot"
            data-thumbnail
            data-full-src="{{ media.preview_image | image_url: width: 800 }}"
            data-alt="{{ media.alt | escape }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ 'products.product.image_number' | t: number: forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>

      <div class="product__thumbnails">
        {%- for media in product.media -%}
          <button
            type="button"
            class="product__thumbnail"
            data-thumbnail
            data-full-src="{{ media.preview_image | image_url: width: 800 }}"
            data-alt="{{ media.alt | escape }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <img src="{{ media.preview_image | image_url: width: 150 }}" alt="" width="72" height="90" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </product-gallery>

  <dialog class="product__zoom-dialog" data-gallery-zoom-dialog>
    <button type="button" class="product__zoom-close" data-dialog-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
    <img data-gallery-zoom-image alt="{{ product.featured_media.alt | escape }}" width="1200" height="1500">
  </dialog>

  <div class="product__info">
    <h1 class="product__title">{{ product.title }}</h1>

    <div class="product__price-row">
      <div class="product__price" data-product-price>
        {%- render 'price', product: current_variant -%}
      </div>
      <span class="product__tax-note">{{ 'products.product.tax_note' | t }}</span>
    </div>

    {%- if section.settings.show_newsletter_incentive and discounted_price < current_variant.price -%}
      <p class="product__newsletter-incentive">
        {{ 'products.product.newsletter_incentive' | t: price: discounted_price_formatted }}
        <button type="button" class="link-underline" data-dialog-open="newsletter-modal">
          {{ 'products.product.newsletter_incentive_link' | t }}
        </button>
      </p>
    {%- endif -%}

    <product-form>
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ current_variant.id }}" ref="variantId">

        {%- if product.has_only_default_variant == false -%}
          <variant-picker>
            <script type="application/json" data-variant-json>
              {{ product.variants | json }}
            </script>

            {%- for option in product.options_with_values -%}
              <fieldset class="product__option" data-option-index="{{ forloop.index0 }}">
                <span class="product__option-name">{{ option.name }}</span>

                {%- if forloop.index0 == color_option_index -%}
                  <div class="swatch-list swatch-list--image">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign swatch_variant = nil
                        for v in product.variants
                          if v.options[color_option_index] == value
                            assign swatch_variant = v
                            break
                          endif
                        endfor
                        assign swatch_image = swatch_variant.featured_image | default: product.featured_image
                      -%}
                      <label
                        class="swatch swatch--image"
                        data-value="{{ value | escape }}"
                        aria-current="{% if current_variant.options[color_option_index] == value %}true{% else %}false{% endif %}"
                      >
                        <input
                          type="radio"
                          name="option-{{ color_option_index }}"
                          value="{{ value | escape }}"
                          class="visually-hidden"
                          {% if current_variant.options[color_option_index] == value %}checked{% endif %}
                        >
                        {%- if swatch_image -%}
                          <img src="{{ swatch_image | image_url: width: 100 }}" alt="{{ value | escape }}" width="44" height="55" loading="lazy">
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="swatch-list">
                    {%- for value in option.values -%}
                      <label
                        class="swatch"
                        data-value="{{ value | escape }}"
                        aria-current="{% if current_variant.options[forloop.parentloop.index0] == value %}true{% else %}false{% endif %}"
                      >
                        <input
                          type="radio"
                          name="option-{{ forloop.parentloop.index0 }}"
                          value="{{ value | escape }}"
                          class="visually-hidden"
                          {% if current_variant.options[forloop.parentloop.index0] == value %}checked{% endif %}
                        >
                        {{ value }}
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </fieldset>
            {%- endfor -%}
          </variant-picker>
        {%- endif -%}

        <div class="product__form-row">
          <quantity-input>
            <div class="quantity-selector">
              <button type="button" data-step="-1" aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-step="1" aria-label="Increase quantity">+</button>
            </div>
          </quantity-input>
        </div>

        <span class="form-error" data-form-error hidden></span>

        <button
          type="submit"
          class="button button--full"
          data-add-to-cart-button
          {% unless current_variant.available %}aria-disabled="true"{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </form>
    </product-form>

    {%- if section.settings.fit_note != blank -%}
      <p class="product__fit-note">{{ section.settings.fit_note }}</p>
    {%- endif -%}

    <div class="product__accordions">
      {%- assign product_type_down = product.type | downcase | strip -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion_item' -%}
          {%- liquid
            assign show_block = true
            if block.settings.limit_product_types != blank
              assign show_block = false
              assign allowed_types = block.settings.limit_product_types | split: ','
              for allowed_type in allowed_types
                assign allowed_type_down = allowed_type | strip | downcase
                if allowed_type_down == product_type_down
                  assign show_block = true
                  break
                endif
              endfor
            endif
          -%}
          {%- if show_block -%}
            <details class="accordion-item" {{ block.shopify_attributes }}>
              <summary class="accordion-item__summary">
                {{ block.settings.title }}
                <span class="accordion-item__icon">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="accordion-item__content rich-text">
                {%- if block.settings.use_description -%}
                  {{ product.description }}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="sticky-add-to-cart" data-sticky-add-to-cart hidden>
  <div class="sticky-add-to-cart__info">
    <span class="sticky-add-to-cart__title">{{ product.title }}</span>
    <span class="sticky-add-to-cart__price">{%- render 'price', product: current_variant -%}</span>
  </div>
  <button type="button" class="button" data-sticky-add-to-cart-button {% unless current_variant.available %}aria-disabled="true"{% endunless %}>
    {%- if current_variant.available -%}
      {{ 'products.product.add_to_cart' | t }}
    {%- else -%}
      {{ 'products.product.sold_out' | t }}
    {%- endif -%}
  </button>
</div>

<script>
  window.themeRecentlyViewed?.record({
    id: {{ product.id | json }},
    title: {{ product.title | json }},
    url: {{ product.url | json }},
    image: {{ product.featured_image | image_url: width: 600 | json }},
    price: {{ current_variant.price | json }},
    compareAtPrice: {{ current_variant.compare_at_price | json }}
  });
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "text",
      "id": "fit_note",
      "label": "Fit note",
      "info": "Optional sizing/fit line shown under the add to cart button, e.g. \"Models are wearing size M\"."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter_incentive",
      "label": "Show newsletter discount line",
      "info": "Discount percent is set in Theme settings → Newsletter.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "checkbox", "id": "use_description", "label": "Use product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content", "visible_if": "{{ block.settings.use_description == false }}" },
        {
          "type": "text",
          "id": "limit_product_types",
          "label": "Limit to product types",
          "info": "Comma-separated list of product types this block should show for, e.g. \"Hoodies, Tees, Pants\". Leave blank to show on every product."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "accordion_item", "settings": { "title": "Product details", "use_description": true } },
      { "type": "accordion_item", "settings": { "title": "Size chart" } },
      { "type": "accordion_item", "settings": { "title": "Shipping details" } }
    ]
  }
}
{% endschema %}
