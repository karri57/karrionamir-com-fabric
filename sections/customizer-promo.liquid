<section class="customizer-promo">
  <div class="page-width customizer-promo__inner">
    <div class="customizer-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="customizer-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="customizer-promo__heading">
        {{ section.settings.heading_solid }}
        <span class="customizer-promo__heading-outline">{{ section.settings.heading_outline }}</span>
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="customizer-promo__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <a href="{{ section.settings.link | default: '/pages/design-studio' }}" class="button">
        {{ section.settings.button_label }}
      </a>
    </div>

    <div class="customizer-promo__visual">
      {%- if section.settings.shirt_image != blank -%}
        <promo-demo class="promo-demo">
          <div class="promo-demo__stage" data-promo-stage>
            <img
              src="{{ section.settings.shirt_image | image_url: width: 900 }}"
              alt="{{ section.settings.shirt_image.alt | escape }}"
              width="900"
              height="{{ 900 | divided_by: section.settings.shirt_image.aspect_ratio | default: 900 }}"
              class="promo-demo__shirt"
              draggable="false"
            >
            <div class="promo-demo__placements" data-promo-placements></div>
            <p class="promo-demo__hint" data-promo-hint>{{ 'sections.customizer_promo.drag_hint' | t }}</p>
          </div>

          <div class="promo-demo__tray-row">
            <div class="promo-demo__tray" data-promo-tray>
              {%- for block in section.blocks -%}
                {%- if block.type == 'design' and block.settings.image != blank -%}
                  <button
                    type="button"
                    class="promo-demo__design"
                    data-promo-design
                    data-src="{{ block.settings.image | image_url: width: 300 }}"
                    aria-label="{{ block.settings.label | default: 'Design' }}"
                    {{ block.shopify_attributes }}
                  >
                    <img
                      src="{{ block.settings.image | image_url: width: 150 }}"
                      alt="{{ block.settings.label }}"
                      width="150"
                      height="{{ 150 | divided_by: block.settings.image.aspect_ratio | default: 150 }}"
                      loading="lazy"
                      draggable="false"
                    >
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button type="button" class="promo-demo__clear" data-promo-clear>{{ 'sections.customizer_promo.clear' | t }}</button>
          </div>
        </promo-demo>

        <script src="{{ 'customizer-promo.js' | asset_url }}" type="module"></script>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="900"
          height="{{ 900 | divided_by: section.settings.image.aspect_ratio | default: 900 }}"
          loading="lazy"
        >
      {%- else -%}
        <svg viewBox="0 0 400 460" aria-hidden="true" class="customizer-promo__tee">
          <path d="M118 60 L62 92 L20 210 L92 240 L108 196 L108 420 Q200 442 292 420 L292 196 L308 240 L380 210 L338 92 L282 60 Q252 34 200 36 Q148 34 118 60 Z" fill="#ffffff" stroke="rgb(0 0 0 / 20%)" stroke-width="2"/>
          <path d="M154 52 Q200 78 246 52" fill="none" stroke="rgb(0 0 0 / 25%)" stroke-width="6" stroke-linecap="round"/>
          <text x="200" y="235" text-anchor="middle" font-size="34" font-weight="700" fill="currentColor" opacity="0.85">YOUR</text>
          <text x="200" y="275" text-anchor="middle" font-size="34" font-weight="700" fill="currentColor" opacity="0.85">DESIGN</text>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customizer promo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KA Studio" },
    { "type": "text", "id": "heading_solid", "label": "Heading (solid)", "default": "Design it" },
    { "type": "text", "id": "heading_outline", "label": "Heading (outlined)", "default": "yourself" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Grab a design and drop it anywhere on the shirt — see what's possible, then build the real thing." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start designing" },
    { "type": "url", "id": "link", "label": "Button link", "info": "Defaults to /pages/design-studio" },
    {
      "type": "image_picker",
      "id": "shirt_image",
      "label": "Shirt photo (interactive demo)",
      "info": "A plain, front-facing photo of a blank shirt (flat lay or on a mannequin works best). When set, this becomes a live drag-and-drop demo using the designs below instead of a static image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Static visual (fallback)",
      "info": "Only used if no shirt photo above is set. Replaces the built-in tee illustration."
    }
  ],
  "blocks": [
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best." }
      ]
    }
  ],
  "presets": [
    { "name": "Customizer promo" }
  ]
}
{% endschema %}
