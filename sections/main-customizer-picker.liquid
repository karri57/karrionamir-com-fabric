{%- comment -%}
  "Choose your canvas" picker: rows of garments to customize. Each card
  plays the same auto design-showcase animation as the home page promo
  (compact mode), and clicking a card opens the designer with that
  garment preselected via ?garment=.
{%- endcomment -%}

{%- liquid
  assign designer_url = section.settings.designer_url | default: '/pages/designer'
-%}

<div class="page-width section picker">
  <div class="picker__header">
    <h1 class="picker__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="picker__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  {%- assign garments = 'tee,hoodie' | split: ',' -%}
  {%- for garment in garments -%}
    {%- liquid
      assign row_heading = section.settings.tee_row_heading
      if garment == 'hoodie'
        assign row_heading = section.settings.hoodie_row_heading
      endif

      assign has_cards = false
      for block in section.blocks
        if block.type == 'product' and block.settings.garment == garment and block.settings.image != blank
          assign has_cards = true
        endif
      endfor
    -%}

    {%- if has_cards -%}
      <div class="picker__row">
        <h2 class="picker__row-heading">{{ row_heading }}</h2>
        <div class="picker__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' and block.settings.garment == garment and block.settings.image != blank -%}
              {%- liquid
                assign colorway_names = block.settings.color_1_name | default: 'Standard'
                assign colorway_names = colorway_names | append: '||' | append: block.settings.color_2_name
                assign colorway_names = colorway_names | append: '||' | append: block.settings.color_3_name
                assign colorway_names = colorway_names | append: '||' | append: block.settings.color_4_name
                assign colorway_names = colorway_names | split: '||'
              -%}
              <div class="picker-card" {{ block.shopify_attributes }}>
              <a href="{{ designer_url }}?canvas={{ block.settings.label | handleize }}" class="picker-card__link">
                <showcase-demo class="showcase picker-card__media" data-compact data-zone="50,42,34,30">
                  <script type="application/json" data-demo-designs>
                    [
                      {%- for design_block in section.blocks -%}
                        {%- if design_block.type == 'design' and design_block.settings.image != blank -%}
                          { "src": {{ design_block.settings.image | image_url: width: 240 | json }} },
                        {%- endif -%}
                      {%- endfor -%}
                      null
                    ]
                  </script>
                  <div class="showcase__stage" data-demo-stage>
                    <img
                      src="{{ block.settings.image | image_url: width: 600 }}"
                      alt="{{ block.settings.label | escape }}"
                      width="600"
                      height="{{ 600 | divided_by: block.settings.image.aspect_ratio | default: 750 }}"
                      class="showcase__shirt showcase__frame showcase__frame--active"
                      data-demo-frame
                      loading="lazy"
                      draggable="false"
                    >
                    {%- assign extra_images = 'image_2,image_3,image_4' | split: ',' -%}
                    {%- for image_key in extra_images -%}
                      {%- assign extra = block.settings[image_key] -%}
                      {%- if extra != blank -%}
                        <img
                          src="{{ extra | image_url: width: 600 }}"
                          alt=""
                          width="600"
                          height="{{ 600 | divided_by: extra.aspect_ratio | default: 750 }}"
                          class="showcase__frame"
                          data-demo-frame
                          loading="lazy"
                          draggable="false"
                        >
                      {%- endif -%}
                    {%- endfor -%}
                    <div class="showcase__layer" data-demo-placements></div>
                  </div>
                  <div class="showcase__cursor showcase__cursor--small" data-demo-cursor aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path d="M4 2 L4 20 L9 15.5 L12.5 22 L15.5 20.5 L12 14 L19 13.5 Z" fill="#111" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </showcase-demo>
                <div class="picker-card__label">{{ block.settings.label }}</div>
                <span class="picker-card__cta">{{ section.settings.card_cta }}</span>
              </a>

              {%- assign colorway_images = 'image,image_2,image_3,image_4' | split: ',' -%}
              {%- assign swatch_count = 0 -%}
              {%- for image_key in colorway_images -%}
                {%- if block.settings[image_key] != blank -%}
                  {%- assign swatch_count = swatch_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if swatch_count > 1 -%}
                <div class="picker-card__swatches">
                  {%- for image_key in colorway_images -%}
                    {%- assign colorway_image = block.settings[image_key] -%}
                    {%- if colorway_image != blank -%}
                      {%- assign colorway_name = colorway_names[forloop.index0] | default: 'Colorway' -%}
                      <button
                        type="button"
                        class="picker-card__swatch"
                        data-picker-swatch="{{ forloop.index0 }}"
                        data-colorway="{{ colorway_name | handleize }}"
                        aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                        title="{{ colorway_name | escape }}"
                        aria-label="{{ colorway_name | escape }}"
                      >
                        <img
                          src="{{ colorway_image | image_url: width: 120 }}"
                          alt=""
                          width="120"
                          height="{{ 120 | divided_by: colorway_image.aspect_ratio | default: 150 }}"
                          loading="lazy"
                        >
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- assign has_products = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product' and block.settings.image != blank -%}
      {%- assign has_products = true -%}
    {%- endif -%}
  {%- endfor -%}
  {%- unless has_products -%}
    <p class="kc__empty">Add garment blocks (with photos) to this section in the theme editor to build the picker.</p>
  {%- endunless -%}
</div>

<script src="{{ 'customizer-promo.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Customizer picker",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your canvas" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Pick the piece you want to customize — then make it yours in the design studio." },
    { "type": "text", "id": "tee_row_heading", "label": "Shirts row heading", "default": "Shirts" },
    { "type": "text", "id": "hoodie_row_heading", "label": "Hoodies row heading", "default": "Hoodies" },
    { "type": "text", "id": "card_cta", "label": "Card call to action", "default": "Customize this" },
    { "type": "url", "id": "designer_url", "label": "Designer page", "info": "Defaults to /pages/designer" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Garment",
      "settings": [
        {
          "type": "select",
          "id": "garment",
          "label": "Garment type",
          "options": [
            { "value": "tee", "label": "Shirt" },
            { "value": "hoodie", "label": "Hoodie" }
          ],
          "default": "tee"
        },
        { "type": "text", "id": "label", "label": "Name", "info": "Must match the canvas name in the Designer page's section so clicking this card opens the right garment.", "default": "Classic Tee" },
        {
          "type": "header",
          "content": "Colorways",
          "info": "Add a photo per colorway. Cards with more than one show swatches and flash between them; picking a swatch carries that colorway into the designer. Names should match the colorway names on the matching Designer canvas."
        },
        { "type": "text", "id": "color_1_name", "label": "Colorway 1 name", "default": "Standard" },
        { "type": "image_picker", "id": "image", "label": "Colorway 1 photo", "info": "Plain, front-facing photo (flat lay works best) — the design animation plays on top of it." },
        { "type": "text", "id": "color_2_name", "label": "Colorway 2 name" },
        { "type": "image_picker", "id": "image_2", "label": "Colorway 2 photo" },
        { "type": "text", "id": "color_3_name", "label": "Colorway 3 name" },
        { "type": "image_picker", "id": "image_3", "label": "Colorway 3 photo" },
        { "type": "text", "id": "color_4_name", "label": "Colorway 4 name" },
        { "type": "image_picker", "id": "image_4", "label": "Colorway 4 photo" }
      ]
    },
    {
      "type": "design",
      "name": "Design",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "Logo" },
        { "type": "image_picker", "id": "image", "label": "Design image", "info": "Transparent PNGs work best. Shared by every card's animation." }
      ]
    }
  ]
}
{% endschema %}
